# Copiar a .env y completar. En Vercel se cargan en Settings → Environment Variables.
# Las marcadas "requerida" rompen la tienda si faltan; el resto apaga solo esa función.

# --- Base de datos (requerida) ---
# Neon: usar la URL con "-pooler" en el host (PgBouncer) para producción.
DATABASE_URL=postgres://usuario:clave@localhost:5432/cordoba_digital
# Conexiones por instancia de la app (por defecto 3). Opcional.
# PG_POOL_MAX=3

# --- Sitio ---
# Dominio público, sin barra final. Lo usan canonicals, sitemap, feed y el login con Google.
SITE_URL=https://www.cordobadigital.net
# Base para las URLs de vuelta de Mercado Pago. Si falta, se toma del request.
APP_URL=https://www.cordobadigital.net
# CUIT que se muestra en el pie de página.
STORE_CUIT=

# --- Mercado Pago ---
MP_ACCESS_TOKEN=
# Clave secreta de la sección Webhooks de MP; valida la firma x-signature.
MP_WEBHOOK_SECRET=

# --- Panel admin ---
# Emails de los dueños (separados por coma): entran con Google y administran Accesos.
ADMIN_EMAILS=
# Contraseña de respaldo para entrar al panel. Vacía = solo Google.
ADMIN_PASSWORD=
# Firma las cookies de sesión del admin. Si falta, se usa ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=

# --- Fotos de producto en Cloudflare R2 (ver docs/IMAGENES-R2.md) ---
# Si falta alguna, las fotos que se suben desde el panel se guardan en Postgres.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Dominio público del bucket, sin barra final (dominio propio o https://pub-xxxx.r2.dev).
R2_PUBLIC_URL=
# Solo para buckets con jurisdicción (p. ej. https://<cuenta>.eu.r2.cloudflarestorage.com).
# R2_ENDPOINT=

# --- Login con Google (clientes y admin) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Reseñas de Google (Places API) ---
GOOGLE_PLACES_API_KEY=
# Opcional: si falta, se busca el local por GOOGLE_PLACE_QUERY.
GOOGLE_PLACE_ID=
GOOGLE_PLACE_QUERY=

# --- Google Analytics y Search Console ---
GA_MEASUREMENT_ID=
# Códigos de la meta google-site-verification, separados por coma.
GOOGLE_SITE_VERIFICATION=

# --- Email (formulario de arrepentimiento) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Córdoba Digital" <no-reply@cordobadigital.net>

# --- Cron de Vercel (vence pedidos sin pagar) ---
# Vercel lo manda como Authorization: Bearer. Sin esta variable el cron no corre.
CRON_SECRET=

# --- Solo scripts (scripts/*) ---
# WC_STORE_URL=https://www.cordobadigital.net
