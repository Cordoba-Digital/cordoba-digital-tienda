{
  "name": "cordoba-digital",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test",
    "test": "node --import tsx --test --test-reporter=spec tests/unit/*.test.mts",
    "test:api": "node --import tsx --experimental-test-module-mocks --test --test-reporter=spec --test-concurrency=1 tests/api/*.test.mts",
    "seguridad": "npm audit --omit=dev --audit-level=high",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:studio": "drizzle-kit studio",
    "audit:wp": "tsx scripts/audit-wp.ts",
    "migrate:wp": "tsx scripts/migrate-wp.ts",
    "verify:wp": "tsx scripts/verify-catalog.ts",
    "audit:site": "tsx scripts/audit-site.ts",
    "check:encoding": "node scripts/check-accents.mjs",
    "reviews:check": "tsx scripts/check-google-reviews.ts",
    "fix:encoding": "node scripts/fix-encoding.mjs",
    "images:migrate": "tsx scripts/migrate-images.ts",
    "backfill:srcsets": "tsx scripts/backfill-image-srcsets.ts",
    "check:gallery": "tsx scripts/check-gallery.ts",
    "check:soft404": "tsx scripts/check-soft404.ts",
    "sync:precios": "tsx scripts/sync-precios.ts",
    "fix:galeria": "tsx scripts/fix-galeria.ts",
    "verificar:flujo": "node scripts/verificar-flujo-compra.mjs",
    "verificar:copy": "node scripts/verificar-copy.mjs",
    "check:contraste": "node scripts/check-contraste.mjs",
    "check:contraste:todo": "node scripts/contraste-todas.mjs",
    "migrar:guias": "tsx scripts/migrar-guias.ts",
    "verificar:guia": "node scripts/verificar-guia.mjs",
    "verificar:guias": "node scripts/verificar-indice-guias.mjs",
    "verificar:claims-guias": "tsx scripts/verificar-claims-guias.ts",
    "verificar:menu": "node scripts/verificar-menu-categorias.mjs",
    "subcategorias": "tsx scripts/subcategorias.ts",
    "categorias:limpiar": "tsx scripts/limpiar-categorias.ts",
    "fichas": "tsx scripts/fichas.ts",
    "garantia": "tsx scripts/garantia.ts",
    "test:e2e": "node --import tsx --test --test-reporter=spec tests/e2e/*.test.mts"
  },
  "dependencies": {
    "@vercel/blob": "2.8.1",
    "aws4fetch": "1.0.20",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "lenis": "^1.3.26",
    "lucide-react": "^1.49.0",
    "mercadopago": "^3.6.1",
    "next": "16.4.0",
    "nodemailer": "^10.0.16",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.0",
    "playwright": "1.63.0",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
